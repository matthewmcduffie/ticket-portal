# Environment — copy this file to .env and fill in all values before running

NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=tickets_db
DB_USER=tickets_user
DB_PASSWORD=change_this_to_a_strong_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=change_this_to_a_very_long_random_string_at_least_64_characters
JWT_EXPIRES_IN=7d

# ── Default admin (created automatically on first run) ────────────────────────
DEFAULT_ADMIN_EMAIL=admin@thelastpatch.com
DEFAULT_ADMIN_PASSWORD=Admin1234!

# ── Domain — Caddy reads this for automatic HTTPS ─────────────────────────────
APP_DOMAIN=tickets.thelastpatch.com

# ── AgentMail (email in/out) ───────────────────────────────────────────────────
AGENTMAIL_API_KEY=your_agentmail_api_key_here
AGENTMAIL_INBOX_ID=ticketsportal@agentmail.to
